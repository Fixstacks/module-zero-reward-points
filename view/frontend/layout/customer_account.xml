-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="zero-reward-navigation-link"
                   ifconfig="zero_reward/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Reward Points</argument>
                    <argument name="path" xsi:type="string">rewards/account</argument>
                    <argument name="sortOrder" xsi:type="number">215</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
