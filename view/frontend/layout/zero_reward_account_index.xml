<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.reward.account"
                   template="Zero_RewardPoints::account.phtml" cacheable="false">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\RewardPoints\ViewModel\Account</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
