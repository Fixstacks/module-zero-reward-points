<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        Every change to a customer's points, per website. The balance is the
        sum. An earning's "remaining" is what of it is still unspent: spending
        and expiry take from the oldest first.
    -->
    <table name="zero_reward_transaction" resource="default" engine="innodb" comment="Zero Reward Points Transactions">
        <column xsi:type="int" name="transaction_id" unsigned="true" nullable="false" identity="true" comment="Transaction ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website ID"/>
        <column xsi:type="int" name="points" nullable="false" comment="Points (+ earned, - spent)"/>
        <column xsi:type="int" name="remaining" unsigned="true" nullable="false" default="0" comment="Unspent Points of an Earning"/>
        <column xsi:type="varchar" name="action" length="32" nullable="false" comment="Action"/>
        <column xsi:type="varchar" name="order_increment_id" length="50" nullable="true" comment="Order"/>
        <column xsi:type="varchar" name="reference" length="64" nullable="true" comment="Reference (review, invoice, credit memo)"/>
        <column xsi:type="varchar" name="comment" length="255" nullable="true" comment="Comment"/>
        <column xsi:type="datetime" name="expires_at" nullable="true" comment="Expires At (UTC)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="transaction_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ZERO_REWARD_TRANSACTION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="zero_reward_transaction" column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ZERO_REWARD_TRANSACTION_CUSTOMER_ID_WEBSITE_ID" indexType="btree">
            <column name="customer_id"/>
            <column name="website_id"/>
        </index>
        <index referenceId="ZERO_REWARD_TRANSACTION_EXPIRES_AT_REMAINING" indexType="btree">
            <column name="expires_at"/>
            <column name="remaining"/>
        </index>
        <index referenceId="ZERO_REWARD_TRANSACTION_ACTION_REFERENCE" indexType="btree">
            <column name="action"/>
            <column name="reference"/>
        </index>
    </table>
    <table name="quote" resource="checkout">
        <column xsi:type="int" name="zero_reward_points" unsigned="true" nullable="false" default="0" comment="Reward Points Asked to Use"/>
        <column xsi:type="int" name="zero_reward_points_used" unsigned="true" nullable="false" default="0" comment="Reward Points Used"/>
        <column xsi:type="decimal" name="zero_reward_amount" scale="4" precision="20" nullable="false" default="0" comment="Reward Points Discount"/>
        <column xsi:type="decimal" name="base_zero_reward_amount" scale="4" precision="20" nullable="false" default="0" comment="Reward Points Discount (Base)"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="int" name="zero_reward_points_used" unsigned="true" nullable="false" default="0" comment="Reward Points Used"/>
        <column xsi:type="decimal" name="zero_reward_amount" scale="4" precision="20" nullable="false" default="0" comment="Reward Points Discount"/>
        <column xsi:type="decimal" name="base_zero_reward_amount" scale="4" precision="20" nullable="false" default="0" comment="Reward Points Discount (Base)"/>
        <column xsi:type="int" name="zero_reward_points_returned" unsigned="true" nullable="false" default="0" comment="Used Points Given Back"/>
        <column xsi:type="int" name="zero_reward_points_earned" unsigned="true" nullable="false" default="0" comment="Reward Points Earned"/>
        <column xsi:type="int" name="zero_reward_points_revoked" unsigned="true" nullable="false" default="0" comment="Earned Points Taken Back"/>
    </table>
</schema>
