<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Spending: taken when the order is placed, given back if placing fails. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="zero_reward_spend" instance="Zero\RewardPoints\Observer\SpendOnOrder"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="zero_reward_spend_failed" instance="Zero\RewardPoints\Observer\ReturnOnFailure"/>
    </event>
    <!-- Earning: once the invoice is paid. -->
    <event name="sales_order_invoice_pay">
        <observer name="zero_reward_earn" instance="Zero\RewardPoints\Observer\EarnOnInvoice"/>
    </event>
    <!-- Cancelled or refunded: used points come back, earned ones go. -->
    <event name="order_cancel_after">
        <observer name="zero_reward_cancel" instance="Zero\RewardPoints\Observer\ReturnOnCancel"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="zero_reward_refund" instance="Zero\RewardPoints\Observer\ReturnOnRefund"/>
    </event>
    <event name="customer_register_success">
        <observer name="zero_reward_signup" instance="Zero\RewardPoints\Observer\SignupBonus"/>
    </event>
    <event name="review_save_after">
        <observer name="zero_reward_review" instance="Zero\RewardPoints\Observer\ReviewBonus"/>
    </event>
</config>
